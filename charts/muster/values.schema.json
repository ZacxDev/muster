{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "muster chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generate": {
          "type": "boolean"
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(|https?://[^/\\s]+/?)$"
    },
    "standalone": {
      "type": "boolean"
    },
    "mirror": {
      "type": "boolean"
    },
    "secureCookies": {
      "type": "boolean"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "password",
            "gotrue"
          ]
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "const": 1,
          "description": "🔴 One replica only (no leader gate: docs/limits.md#deployment)."
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": [
            "object",
            "array"
          ]
        },
        "affinity": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "extraEnvFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "connectPort": {
          "type": "integer"
        },
        "browserPort": {
          "type": "integer"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeouts": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provisioner": {
          "enum": [
            "kubernetes",
            "noop"
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "gateway",
              "claude-code"
            ]
          },
          "contains": {
            "const": "gateway"
          },
          "uniqueItems": true
        },
        "namespacePrefix": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?-$",
          "maxLength": 40
        },
        "gatewayImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "apiUrl": {
          "type": "string"
        },
        "connectUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persist": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string"
            },
            "runtimeConfig": {
              "type": "string"
            },
            "runtimeInstall": {
              "type": "string"
            }
          }
        },
        "claudeCode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,32}$"
              },
              "uniqueItems": true
            },
            "tokensSecret": {
              "type": "string"
            },
            "storageSize": {
              "type": "string"
            }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "create": {
              "type": "boolean"
            },
            "layout": {
              "enum": [
                "least-privilege",
                "cluster-wide"
              ]
            },
            "sourceSecretNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "admissionPolicy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "chief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatchOwners": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ],
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "taskRouting": {
          "type": "boolean"
        },
        "openrouter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": "string"
            }
          }
        },
        "openrouterSessions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "dailyUSD": {
              "type": "string"
            },
            "sessionUSD": {
              "type": "string"
            }
          }
        }
      }
    },
    "plugins": {
      "type": "boolean"
    },
    "officers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "config": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tokensSecret": {
          "type": "string"
        },
        "egressCidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "egressDns": {
          "enum": [
            "",
            "unfiltered"
          ]
        }
      }
    },
    "connectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "githubApp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "appId": {
          "type": [
            "string",
            "integer"
          ]
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "login",
              "id"
            ],
            "properties": {
              "login": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": [
                  "integer",
                  "string"
                ],
                "pattern": "^[0-9]+$"
              }
            }
          }
        },
        "access": {
          "enum": [
            "",
            "write",
            "read"
          ]
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "openrouter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "subject": {
          "type": "string",
          "pattern": "^(|mailto:.+|https://.+)$"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "attachments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "signingKeySecret": {
          "type": "string"
        },
        "maxBytes": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        }
      }
    },
    "dictation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "stt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "model": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "gotrue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
