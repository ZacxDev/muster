        "type": "string"
      },
      "note": {
        "description": "Optional: your own words, shown last in the ask and labelled as yours. Never a credential.",
        "type": "string"
      }
    },
    "required": [
      "item_id"
    ],
    "type": "object"
  }
}
{
  "type": "function",
  "name": "officer_task_get",
  "description": "Read one HQ task (GET /officers/{id}/tasks/{task_id}): the task, its comments (oldest first) and its type's statuses and done_statuses. A private or absent task is a 404 task_not_visible. A refusal with code task_route_unavailable means this HQ has no task route yet: NOT a missing task; do not retry, report it. An answer over muster's 1 MiB cap is refused whole. Quote what you use from it with its date. Read-only.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "task_id": {
        "description": "The task's id, as officer_task_list or an item's payload names it.",
        "type": "string"
