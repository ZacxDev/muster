{
  "type": "function",
  "name": "officer_rollout_status",
  "description": "Read muster's rollout watch of your latest release: phase, verdict (watching, healthy, not_live, unhealthy, superseded), the revert pull request and rollback tag if one was made, and its events. Put the verdict in your item's officer_complete summary.",
  "parameters": {
    "additionalProperties": false,
    "properties": {},
    "type": "object"
  }
}
{
  "type": "function",
  "name": "officer_tag_release",
  "description": "Tag the next release (the highest vX.Y.Z with its minor bumped) on the base branch's head, as an annotated tag. muster checks every release gate at call time — stage, HQ enabled, the highest tag is an ancestor of the head, no release in flight and the previous one live, the daily rate and minimum gap, quiet hours, CI green for the head's exact tree, migrations (and HQ's backup preflight when one is added) — then creates the tag and watches the rollout. A tag someone else pushes at the same moment makes this fail and nothing is created. Give item_id to have the watch name your item.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
      "item_id": {
        "description": "Optional: the HQ item this release is for.",
        "type": "string"
      }
    },
    "type": "object"
  }
}
