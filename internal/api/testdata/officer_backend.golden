        "description": "Optional http(s) URL with the context (a pull request, a preview, a dashboard).",
        "type": "string"
      },
      "deadline_seconds": {
        "description": "Optional: how long they have to answer, in seconds (HQ's default is a day; HQ refuses a value outside its range).",
        "type": "integer"
      },
      "image_ids": {
        "description": "Optional images, as the ids `ccd ask-image \u003cpath\u003e` prints: run it in your shell on a PNG, JPEG or WebP file in your workspace (at most 5 MiB) and pass the \"id\" it prints. For an image on the web, download it into your workspace first. The ask cites them in order.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "item_id": {
        "description": "The item's id, as officer_items or officer_brief returned it.",
        "type": "string"
      },
