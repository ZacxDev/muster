        "type": "object"
      },
      "item_id": {
        "description": "The item's id, as officer_items or officer_brief returned it.",
        "type": "string"
      },
      "links": {
        "description": "Optional http(s) URLs (a PR, a dashboard, a report), at most 10.",
        "items": {
          "type": "string"
        },
        "maxItems": 10,
        "type": "array"
      },
      "outcome": {
        "enum": [
          "done",
          "escalated",
          "no_action",
          "needs_judgement"
        ],
        "type": "string"
      },
      "summary": {
        "description": "What you found and did, at most 24,576 characters.",
        "type": "string"
      }
    },
    "required": [
      "item_id",
      "outcome",
      "summary"
    ],
    "type": "object"
  }
}
