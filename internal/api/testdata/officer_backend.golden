    ],
    "type": "object"
  }
}
{
  "type": "function",
  "name": "officer_task_ask",
  "description": "Ask HQ to ask a finding's task owner to approve one action on the task (POST /officers/{id}/items/{item_id}/task-asks), for a task-reconciler.finding item you hold. You do NOT choose the task, the person, the question or the options: HQ derives them from the item. HQ — never you — applies the person's answer. On success NOTHING has been applied yet, so never claim the task was changed. 🔴 Success ENDS your lease on the item (it becomes waiting): stop working it — do not heartbeat, complete or release it. HQ owns every limit; a refusal comes back verbatim with HQ's status, code and message, and nothing was written. Do not retry an identical refused call. If muster says HQ is unavailable, the request may still have committed: check the item (officer_items) for an open ask before retrying, so you do not ask twice.",
  "parameters": {
    "additionalProperties": false,
    "properties": {
