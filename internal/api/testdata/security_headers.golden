# Every GET route's Content-Security-Policy and Permissions-Policy, served to the owner of a live
# app plugin (security_headers_golden_pg_test.go). Regenerate with
#   UPDATE_SECURITY_HEADERS_GOLDEN=1 go test ./internal/api -run TestOnlyTheAppPageWidensItsHeaders
# then READ the diff.
csp1 = default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*:*/brand/icon-192.png http://localhost:*/brand/icon-192.png http://127.0.0.1:*/brand/icon-192.png; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
csp3 = default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*:*/brand/icon-192.png http://localhost:*/brand/icon-192.png http://127.0.0.1:*/brand/icon-192.png; connect-src 'self'; frame-ancestors 'none'; frame-src https://w.viewer.example.net; base-uri 'self'; form-action 'self'
csp5 = default-src 'none'
pp2 = microphone=(self)
pp4 = microphone=(self "https://w.viewer.example.net"), camera=(self "https://w.viewer.example.net"), display-capture=(self "https://w.viewer.example.net"), fullscreen=(self "https://w.viewer.example.net"), autoplay=(self "https://w.viewer.example.net"), clipboard-write=(self "https://w.viewer.example.net")

