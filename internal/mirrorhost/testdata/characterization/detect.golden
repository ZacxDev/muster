guard %shell found=false pid=0 rule="" err=nil multiplexer=false/0
guard %claude found=false pid=0 rule="" err=nil multiplexer=false/0
guard %hermes found=true pid=121 rule="comm=hermes" err=nil multiplexer=false/0
guard %gateway found=true pid=131 rule="comm=hermes" err=nil multiplexer=false/0
guard %profile found=true pid=141 rule="comm=hermes" err=nil multiplexer=false/0
guard %module found=true pid=151 rule="python running hermes" err=nil multiplexer=false/0
guard %tmux found=true pid=161 rule="multiplexer client" err=nil multiplexer=true/161
guard %opencode found=true pid=171 rule="opencode" err=nil multiplexer=false/0
guard %claudehermes found=true pid=182 rule="comm=hermes" err=nil multiplexer=false/0
guard %othertty found=true pid=191 rule="comm=hermes" err=nil multiplexer=false/0
guard %ocnode found=false pid=0 rule="" err=nil multiplexer=false/0
guard %nvim found=false pid=0 rule="" err=nil multiplexer=false/0
guard %absent found=false pid=0 rule="" err=error multiplexer=false/0
runtimes ["claude" "hermes"]
attached %shell claude=false agent=null
attached %claude claude=true agent=null
attached %hermes claude=false agent={"Runtime":"hermes","Pane":"%hermes","PID":121,"Transcript":"","Gen":"","Busy":false,"Status":"","StatusSince":0,"RawStatus":"","StartedAt":0,"Shells":{"N":0,"Monitor":false},"Pending":null,"LastMessage":0,"Source":"process","Hermes":null}
attached %gateway claude=false agent=null
attached %profile claude=false agent=null
attached %module claude=false agent=null
attached %tmux claude=false agent=null
attached %opencode claude=false agent=null
attached %claudehermes claude=true agent=null
attached %othertty claude=false agent=null
attached %ocnode claude=false agent=null
attached %nvim claude=false agent=null
attached %absent claude=false agent=null
wire {"session":"work","id":"@1","index":0,"active":true,"command":"zsh"}
wire {"session":"work","id":"@2","index":1,"claude":true,"command":"zsh","status":"idle","statusSince":1,"claudeSession":"c-claude"}
