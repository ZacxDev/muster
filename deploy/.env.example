# muster — settings for deploy/docker-compose.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# (A GitHub Release attaches this file as `env.example`, without the dot,
# because GitHub renames assets whose name starts with a period. Save it as
# .env.)
#
# Fill in every CHANGE-ME. Generate a secret with:
#   openssl rand -hex 32
# (MUSTER_UI_PASSWORD must be at least 12 characters: a shorter one, such as an
# unedited CHANGE-ME, keeps the sign-in page refused and muster unhealthy.)
#
# The required block is the whole core. Everything below it is OPTIONAL and
# commented out: to turn a feature on, uncomment its lines, fill them in, and
# run `docker compose up -d` again. Each block names its section of
# docs/features.md (https://github.com/ZacxDev/muster/blob/main/docs/features.md),
# which says what the feature needs and how to check it is on. An empty value
# is the same as leaving the line out, except MUSTER_SESSION_STATE (empty is
# off; see its block).

# The release to run. The env.example attached to a GitHub Release has this
# filled in already; the copy in the repository leaves it empty on purpose.
MUSTER_VERSION=

# --- required ---------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE-ME
# The password for the web UI's sign-in page (12 characters or more).
MUSTER_UI_PASSWORD=CHANGE-ME
# The machine secret every muster-mirror and hook presents. It acts as the
# admin, so treat it like a root password. 12 characters or more; muster
# refuses to start with this placeholder.
MUSTER_HOOK_TOKEN=CHANGE-ME

# --- network -----------------------------------------------------------------
# muster is published on 127.0.0.1:8105 only. Front it with HTTPS, e.g.
#   tailscale serve --bg 8105
# and set MUSTER_PUBLIC_URL to the address people open (attachments and
# invites need it).
#MUSTER_PUBLIC_URL=https://muster.example.ts.net
#MUSTER_HTTP_PORT=8105
#MUSTER_BIND=127.0.0.1
# Session cookies are marked Secure (https only) by default. Set 0 only to sign
# in over plain http from another machine, never in production.
#MUSTER_SECURE_COOKIES=1
# Compose's own project name (containers, network and volumes are prefixed
# with it). Change it only to run a second, separate stack on one machine.
#COMPOSE_PROJECT_NAME=muster

# --- testing a locally built image (not for production) ----------------------
# The repository's own tests run this file against `make image` output.
#MUSTER_IMAGE=muster-local
# The same, for the chief's container (profile chief): a locally built
# claude-code-agent image.
#CHIEF_IMAGE=claude-code-agent-local

# =============================================================================
# OPTIONAL FEATURES (docs/features.md)
# =============================================================================

# --- bundled extras: the ONE COMPOSE_PROFILES line ---------------------------
# docs/features.md#dictation and docs/features.md#attachments. List every
# profile you use on this one line, comma-separated: a second COMPOSE_PROFILES
# line would replace this one, silently dropping its profiles.
#   stt         CPU dictation (speaches)          stt-cohere  GPU dictation
#   s3          the file-attachment store (Silo)
#   chief       the chief, your fleet agent (see its block below)
#COMPOSE_PROFILES=stt,s3

# --- web push notifications: docs/features.md#push ---------------------------
# All three or none. Generate the keypair — this APPENDS the two key lines to
# .env, so do not also write them by hand:
#   docker compose run --rm --no-deps muster vapid generate >> .env
# then set the contact address push services are given:
#MUSTER_VAPID_SUBJECT=mailto:you@example.com
#MUSTER_VAPID_PUBLIC_KEY=
#MUSTER_VAPID_PRIVATE_KEY=
# Your own push hosts (a self-hosted ntfy for the Android app), comma-separated.
#MUSTER_PUSH_EXTRA_HOSTS=ntfy.example.com

# --- dictation: docs/features.md#dictation ------------------------------------
# Pick ONE of the three blocks below and uncomment it. MUSTER_STT_TOKEN is what
# turns dictation on; leave it unset for no dictation. docs/dictation.md has
# the details.

# (1) stt — CPU, bundled (speaches, faster-whisper). The token is the only
#     line: with it set and nothing else, muster talks to the stt-whisper
#     service with the model below. The model downloads on first start; a
#     larger one is more accurate and slower (set MUSTER_STT_MODEL to change
#     it, e.g. Systran/faster-whisper-medium).
#   (profile: stt, on the COMPOSE_PROFILES line above)
#MUSTER_STT_TOKEN=CHANGE-ME

# (2) stt-cohere — GPU, more accurate. About 6 GB of VRAM and the NVIDIA
#     container toolkit. HF_TOKEN must belong to a Hugging Face account that
#     accepted the license of CohereLabs/cohere-transcribe-03-2026 (gated).
#     The server ignores the model field; naming its model keeps muster's
#     boot line accurate.
#   (profile: stt-cohere, on the COMPOSE_PROFILES line above)
#MUSTER_STT_URL=http://stt-cohere:8000
#MUSTER_STT_TOKEN=CHANGE-ME
#MUSTER_STT_MODEL=CohereLabs/cohere-transcribe-03-2026
#HF_TOKEN=CHANGE-ME
# The image stt-cohere runs; leave unset for the release's own.
#STT_COHERE_IMAGE=ghcr.io/zacxdev/muster-stt-cohere

# (3) Your own OpenAI-compatible API key — no container. muster sends the
#     recording to the provider; the key never reaches a browser.
#MUSTER_STT_URL=https://api.openai.com
#MUSTER_STT_TOKEN=CHANGE-ME
#MUSTER_STT_MODEL=whisper-1

# --- file attachments: docs/features.md#attachments --------------------------
# With the bundled store (profile s3), these two lines are all (plus
# MUSTER_PUBLIC_URL above, which every agent link is written on). The store's
# secret is its root password and muster's secret key: 8 characters or more.
# The signing key signs the links agents get: at least 32 bytes
# (openssl rand -base64 48).
#   (profile: s3, on the COMPOSE_PROFILES line above; leave MUSTER_S3_ENDPOINT unset)
#S3_STORE_SECRET_KEY=CHANGE-ME
#MUSTER_UPLOAD_SIGNING_KEY=CHANGE-ME
# Your own S3-compatible store instead: no profile, no S3_STORE_SECRET_KEY,
# and ALL of these plus the signing key (nothing is filled in for you).
#MUSTER_S3_ENDPOINT=https://s3.example.com
#MUSTER_S3_BUCKET=muster-uploads
#MUSTER_S3_ACCESS_KEY=CHANGE-ME
#MUSTER_S3_SECRET_KEY=CHANGE-ME
#MUSTER_S3_REGION=us-east-1
# Limits: the largest file in bytes (default 25 MiB), and how long an agent's
# link works (default 24h).
#MUSTER_UPLOAD_MAX_BYTES=26214400
#MUSTER_UPLOAD_LINK_TTL=24h

# --- suggested replies and session focus: docs/features.md#suggested-replies --
# Both are off until this OpenRouter key is set, which turns them on. It
# is the admin's (in password sign-in, everyone is the admin). Also used by
# docs/features.md#focus and the stall classifier.
#MUSTER_AGENT_OPENROUTER_KEY=CHANGE-ME
# `off` turns suggested replies off for everyone; the model they use.
#MUSTER_SUGGEST=off
#MUSTER_SUGGEST_MODEL=openai/gpt-6-luna
# Session focus (docs/features.md#focus): how often it is recomputed (0 = off),
# how long an unseen session's focus is kept, and the model it uses.
#MUSTER_FOCUS_INTERVAL=15m
#MUSTER_FOCUS_RETENTION=168h
#MUSTER_FOCUS_MODEL=scaledown/summarize

# --- per-user accounts: docs/features.md#accounts -----------------------------
# ADVANCED: needs a GoTrue server you run, and a second published port (the
# browser listener; docs/features.md#accounts has the override file).
#MUSTER_AUTH_MODE=gotrue
#MUSTER_GOTRUE_URL=http://gotrue:9999
#MUSTER_GOTRUE_JWT_SECRET=CHANGE-ME
#MUSTER_BROWSER_PORT=8106

# --- connector store: docs/features.md#connectors ----------------------------
# A 32-byte base64 key (head -c32 /dev/urandom | base64). Turns on the
# Connectors tab and members' own stored credentials.
#MUSTER_CONNECTOR_ENCRYPTION_KEY=CHANGE-ME
# 1 refuses postgres connectors to loopback and private addresses, for an
# install whose admins do not run the host. Off by default.
#MUSTER_DIAL_DENY_PRIVATE=1

# --- GitHub App: docs/features.md#github-app ---------------------------------
# Needs the connector store. The private key is the PEM file's content: write
# it on one line in double quotes with \n for each line break.
#MUSTER_GITHUB_APP_ID=123456
#MUSTER_GITHUB_APP_PRIVATE_KEY="<the .pem file on one line, with \n for each line break>"
#MUSTER_GITHUB_APP_ACCOUNTS=example-org:12345
#MUSTER_GITHUB_APP_ACCESS=write

# --- session state: docs/features.md#session-state ---------------------------
# ON by default in this stack, upgrades included: one push per stop, and the
# Asks page's Stalled / waiting section. It needs nothing beyond the core's
# database. 0 (or an empty value) turns it off and brings back the older
# per-event notifications.
#MUSTER_SESSION_STATE=0

# --- the ask log: docs/features.md#ask-log -----------------------------------
# Records every question an agent asks you — a plain-text question at a turn's
# end, an AskUserQuestion picker, an attention_ask, an opencode form or
# permission request — with your answer, who gave it and how long it took.
# Telemetry only: nothing is answered for you. Redacted, yours only; question
# and answer text is cleared after MUSTER_ASK_LOG_TEXT_TTL (720h by default).
#MUSTER_ASK_LOG=1
#MUSTER_ASK_LOG_TEXT_TTL=720h
#MUSTER_ASK_LOG_CLASSIFY=1

# --- shareable pages: docs/features.md#pages ----------------------------------
# Agents publish small pages for you — a showcase, questions, a form, uploads,
# their own script in a sandbox — and ask you before a link anyone can open goes
# live. Links are on MUSTER_PUBLIC_URL; uploads need attachments (above).
#MUSTER_PAGES=1
# A page's files in all (500 MiB when unset):
#MUSTER_PAGES_UPLOAD_BYTES=524288000

# --- the chief: docs/features.md#chief ---------------------------------------
# Your fleet agent: it says what every session and agent is working on, who is
# on what, and routes work to the right session. Off by default. To turn it
# on: add `chief` to COMPOSE_PROFILES above, uncomment MUSTER_CHIEF_RUNTIME,
# set MUSTER_CONNECTOR_ENCRYPTION_KEY (its block below), give it ONE
# credential, run `docker compose up -d --wait`, then Account → Chief → Turn
# the chief on (the admin's account: this install runs one chief).
#MUSTER_CHIEF_RUNTIME=compose
# Its credential, one of:
#  - a Claude subscription token, from `claude setup-token`:
#MUSTER_CHIEF_CLAUDE_TOKEN=CHANGE-ME
#  - or your OpenRouter key, MUSTER_AGENT_OPENROUTER_KEY (its block above).
#    🔴 muster adds NO budget of its own: set a credit limit on the key itself
#    at https://openrouter.ai/settings/keys — it is the only spending cap.
#    The model it runs (default deepseek/deepseek-v4.1-flash):
#MUSTER_CHIEF_LLM_MODEL=deepseek/deepseek-v4.1-flash
# The chief container can reach the internet, on either credential: its
# network is NOT confined (it cannot reach muster's database). Routing work to sessions also needs
# MUSTER_SESSION_ROUTING=1 (the next block; plugins are not needed for it).

# --- plugins and routing: docs/features.md#plugins ---------------------------
# ADVANCED: a plugin process you run; messages go to your chief.
#MUSTER_PLUGINS=1
#MUSTER_PLUGIN_TASK_NAMESPACES=inbox
#MUSTER_PLUGIN_ORIGINS=https://*.preview.example.net
#MUSTER_SESSION_ROUTING=1
#MUSTER_ROUTE_RELAY_ALLOW=
#MUSTER_TASK_ROUTING=1
#MUSTER_PR_MAIL_SENDERS=
#MUSTER_FLEET_REPORT_SENDERS=
#MUSTER_FLEET_REPORT_PATHS=
#MUSTER_MAIL_RESUME_ALLOW=
#MUSTER_MAIL_RESUME_OFF=1

# --- permission router: docs/features.md#approval-router ---------------------
# ADVANCED: an external router you run. muster runs standalone by default, and
# the two refuse to boot together, so set MUSTER_STANDALONE=0 with a router.
#MUSTER_STANDALONE=0
#MUSTER_ROUTER_URL=https://router.example.ts.net
#MUSTER_ROUTER_TOKEN=CHANGE-ME
#MUSTER_ROUTER_ACTOR=muster
#MUSTER_ROUTER_ACTOR_HEADER=X-Router-Actor
#MUSTER_ROUTER_TOKEN_HEADER=X-Router-Token
# The router's approval gate alone is allowed beside standalone.
#MUSTER_APPROVAL_GATE_URL=https://router.example.ts.net/api/gate
#MUSTER_APPROVAL_GATE_TOKEN=CHANGE-ME
#MUSTER_LEGACY_PROVENANCE_HEADER_PREFIX=

# --- browser flows: docs/features.md#browser-flows ---------------------------
# Names (your hosts, clusters, projects) an agent may not put into flow text.
# Setting it also silences the boot warning about it.
#MUSTER_FLOW_AGENT_DENY_WORDS=

# --- the Android app: docs/features.md#android -------------------------------
#MUSTER_ANDROID_PACKAGE=
#MUSTER_ANDROID_CERT_SHA256=
#MUSTER_ANDROID_ALLOW_PIN_KEYS=1
# Behind a single sign-on proxy: the exact https origins its sign-in passes
# through, which the app loads in its WebView (docs/auth.md).
#MUSTER_ANDROID_SSO_ORIGINS=https://sso.example.com,https://idp.example.com

# --- telemetry: docs/features.md#telemetry -----------------------------------
# Grafana Faro (front-end monitoring), through muster's own relay or direct.
#MUSTER_FARO_UPSTREAM=
#MUSTER_FARO_URL=
#MUSTER_FARO_API_KEY=
#MUSTER_FARO_TRACING=1
# OpenTelemetry traces over OTLP/HTTP. The endpoint turns them on.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
#OTEL_EXPORTER_OTLP_HEADERS=
#OTEL_EXPORTER_OTLP_TIMEOUT=10000
#OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=
#OTEL_SDK_DISABLED=true
#OTEL_SERVICE_NAME=muster-server
#OTEL_RESOURCE_ATTRIBUTES=
#MUSTER_TRACE_SAMPLE_RATIO=0.05

# --- other settings: docs/features.md#other-settings -------------------------
#MUSTER_SERVICE_TOKEN=CHANGE-ME
#MUSTER_STEPUP_WINDOW=12h
#MUSTER_LIVE_HEARTBEAT=15s
#MUSTER_SEND_QUEUE_IDLE=30s
#MUSTER_TASK_REAP_AFTER=168h
#MUSTER_AGENTS_IDLE_AFTER=14d
#MUSTER_AGENT_STUCK_NO_REPLY=5m
#MUSTER_AGENT_STUCK_SILENT=30m
#MUSTER_AGENT_WATCHDOG_INTERVAL=1m
#MUSTER_HOST_ICONS=laptop=laptop,tower=server
